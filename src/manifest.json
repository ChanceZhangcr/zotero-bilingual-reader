{
  "manifest_version": 2,
  "name": "Bilingual Paper Reader (双语论文助手)",
  "version": "1.4.1",
  "description": "一键把英文论文翻译成中文（4 个免密钥引擎，国内直连），左右对照阅读；可导出「中文版 + 中英对照版」PDF。",
  "homepage_url": "https://github.com/ChanceZhangcr/zotero-bilingual-reader",
  "author": "built with DeepSeek Harness",
  "icons": {
    "48": "chrome/content/icons/icon48.svg",
    "96": "chrome/content/icons/icon96.svg"
  },
  "applications": {
    "zotero": {
      "id": "bilingual-reader@local.plugin",
      "update_url": "https://raw.githubusercontent.com/ChanceZhangcr/zotero-bilingual-reader/main/update.json",
      "strict_min_version": "7.0",
      "strict_max_version": "9.9.*"
    }
  }
}
